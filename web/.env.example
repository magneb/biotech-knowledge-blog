# Local Next.js environment variables (used by next dev / next build)
# Copy to web/.env.local and fill in real values. Never commit web/.env.local!

NEXT_PUBLIC_SANITY_PROJECT_ID="9bx84ykf"
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity Viewer API token (required for Draft Mode, Presentation Tool, and Live Preview)
SANITY_API_READ_TOKEN=""

# Shared secret for verifying incoming Sanity GROQ webhook requests at POST /api/revalidate
SANITY_REVALIDATE_SECRET=""

# Sanity Studio URL for Visual Editing overlays (defaults to http://localhost:3333 in dev)
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
