{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olivers-guide-to-everything",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "olivers-guide-to-everything"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "75e5c34613a6409e8a5ffbb06fbdbd10"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "olivers-guide-tag-cache",
      "database_id": "8380a4c0-3be8-42f1-8bf9-f4afc6f7a6ce"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
