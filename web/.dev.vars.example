# Local Cloudflare Worker secrets & environment variables (used by wrangler dev / opennextjs-cloudflare preview)
# Copy to web/.dev.vars and fill in real values. Never commit web/.dev.vars!

# Sanity Viewer API token (required for Draft Mode, Presentation Tool, and standalone live preview)
SANITY_API_READ_TOKEN=""

# Shared secret for verifying incoming Sanity GROQ webhook requests at POST /api/revalidate
SANITY_REVALIDATE_SECRET=""

# Optional: Sanity Studio URL for Visual Editing Stega overlays (defaults to http://localhost:3333)
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
