{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next/dev/cache/fetch-cache && next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run check && opennextjs-cloudflare build && node scripts/smoke-test-worker.mjs --skip-build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:smoke": "node scripts/smoke-test-worker.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run test:smoke",
    "cache:purge": "node scripts/purge-cache.mjs",
    "site:maintenance": "node scripts/site-maintenance.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@sanity/image-url": "^2.1.1",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
