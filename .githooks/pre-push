#!/usr/bin/env bash
set -euo pipefail

echo "══════════════════════════════════════════════════════════════════"
echo "  Pre-Push Gate: Running 3-Tier Verification (Oliver's Guide)     "
echo "  (Set SKIP_SMOKE=1 to run fast static+unit checks only)          "
echo "══════════════════════════════════════════════════════════════════"

if [[ "${SKIP_SMOKE:-0}" == "1" ]]; then
  npm run check
else
  npm run verify
fi

echo "✓ Pre-push verification succeeded."
